PORT=4000
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Keep false to store checkout/customer/address data only in Razorpay order notes.
CHECKOUT_DATABASE_ENABLED=false
RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxx
# Generate with: npm run hash-admin-password -- "your strong password"
ADMIN_PASSWORD_HASH=scrypt$generated_salt$generated_hash
# Generate at least 32 random bytes, for example: openssl rand -base64 48
JWT_SECRET=replace_with_at_least_32_random_characters
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=skyedevices@outlook.com
SMTP_PASS=your_outlook_password
FROM_EMAIL=skyedevices@outlook.com
FRONTEND_URL=https://skyedevices.com
NODE_ENV=production
# Keep false to send checkout directly to Razorpay and store customer/address details in order notes.
CHECKOUT_DATABASE_ENABLED=false
# Enables the local-only ₹1 GANDHI checkout coupon in production when explicitly set.
ENABLE_TEST_COUPON=false
